# Yahoo! Cloud System Benchmark
# Workload A: Update heavy workload
#   Application example: Session store recording recent actions
#                        
#   Read/update ratio: 50/50
#   Default data size: 1 KB records (10 fields, 100 bytes each, plus key)
#   Request distribution: zipfian

recordcount=50000000
maxexecutiontime=300
workload=site.ycsb.workloads.CoreWorkload

status.interval=3

fieldcount=1
fieldlength=116

readallfields=false

workloadcount=2

readproportion_1=0.2
updateproportion_1=0
scanproportion_1=0
insertproportion_1=0.8
stopcondition_1=duration
workloadduration_1=30

readproportion_2=0
updateproportion_2=0
scanproportion_2=0.5
insertproportion_2=0.5
stopcondition_2=duration
workloadduration_2=120


# requestdistribution=zipfian
requestdistribution=latest

rocksdb.dir=/home/user/research/data
rocksdb.optionsfile=/home/user/research/YCSB_DIO/rocksdb/options.ini




